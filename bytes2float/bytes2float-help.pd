#N canvas 100 100 650 450 14;
#X obj 50 50 bytes2float;
#X msg 50 20 63 144 68 66;
#X floatatom 50 80 8 0 0 0 float - -, f 5;
#X text 50 120 bytes2float convertit 4 bytes little-endian en float32;
#X text 50 150 Inlet: liste de bytes (0-255);
#X text 50 170 Outlet 0: float converti;
#X text 50 190 Outlet 1: bytes supplémentaires ou invalides;
#X text 50 230 Comportement:;
#X text 50 250 - < 4 bytes: complète avec 0;
#X text 50 270 - > 4 bytes: sort les 4 premiers, reste sur outlet 1;
#X text 50 290 - bytes invalides (<0 ou >255): tout sur outlet 1;
#X obj 50 320 print float;
#X obj 50 340 print extra;
#X msg 50 -10 63 144 68 66 99 100 200;
#X connect 0 0 2 0;
#X connect 0 1 11 0;
#X connect 1 0 0 0;
#X connect 12 0 0 0;
