#N canvas 100 100 600 500 12;
#X text 50 20 Test xiao_serial - Mode stub sur macOS;
#X text 50 40 =========================================;
#X text 50 70 Note: Sur macOS, l'external est en mode stub;
#X text 50 90 (sans support termios). Il affichera des warnings;
#X text 50 110 mais les méthodes fonctionnent pour tester la structure.;
#X obj 50 150 xiao_serial;
#X obj 50 180 msg open /dev/ttyUSB0 115200;
#X obj 200 180 msg close;
#X obj 350 180 msg interval 10;
#X obj 50 220 list 72 101 108 108 111;
#X text 50 250 Bytes à envoyer: 72 101 108 108 111 (Hello en ASCII);
#X obj 50 280 unpack f f f f f;
#X obj 50 310 print byte0;
#X obj 100 310 print byte1;
#X obj 150 310 print byte2;
#X obj 200 310 print byte3;
#X obj 250 310 print byte4;
#X obj 50 350 print bytes_received;
#X text 50 380 Test des méthodes:;
#X text 50 400 1. Cliquez sur [msg open ...] pour tester l'ouverture;
#X text 50 420 2. Cliquez sur [msg close] pour fermer;
#X text 50 440 3. Envoyez [list 72 101 108 108 111] pour tester l'envoi;
#X connect 0 0 5 0;
#X connect 0 0 10 0;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 0 0;
#X connect 4 0 0 0;
#X connect 5 0 6 0;
#X connect 5 1 7 0;
#X connect 5 2 8 0;
#X connect 5 3 9 0;
#X connect 5 4 10 0;
