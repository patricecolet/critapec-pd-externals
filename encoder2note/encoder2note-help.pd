#N canvas 100 100 800 650 12;
#X obj 50 290 encoder2note 12 0 24;
#X floatatom 50 320 10 0 0 0 demi-tons - - 0;
#X obj 50 180 nbx 5 14 -1e+37 1e+37 0 0 empty empty tours 0 -8 0 10 #fcfcfc #000000 #000000 0 256;
#X text 50 20 encoder2note - Convertit tours d'encodeur en notes musicales;
#X text 50 50 Création: [encoder2note vitesse min_note max_note];
#X text 49 75 Inlet gauche: nombre de tours (ex: 2.5 = 2 tours et demi);
#X text 50 98 Inlet droit: vitesse de 1 à 48 demi-tons/tour (valeurs continues);
#X text 49 133 Outlet: demi-tons avec décimales (ex: 12.5 = 12 demi-tons + 50 centièmes);
#X text 384 201 Exemples de vitesses (1 à 48):;
#X msg 384 221 1;
#X msg 424 221 6;
#X msg 464 221 12;
#X msg 504 221 24;
#X msg 544 221 48;
#X msg 590 221 18.5;
#X text 50 350 AVEC AMBITUS: la note est limitée entre min et max;
#X msg 50 220 reset;
#X msg 100 220 set 12;
#X msg 205 220 max 48;
#X text 50 390 Messages:;
#X text 50 410 - reset: remet l'accumulateur à 0;
#X text 50 430 - set N: définit l'accumulateur à N demi-tons;
#X text 50 450 - min N: définit la note minimum (ambitus);
#X text 50 470 - max N: définit la note maximum (ambitus);
#X text 50 490 - gear N: définit la vitesse (1 à 48 avec validation);
#X text 50 520 Défaut ambitus: -48 à +48 (8 octaves);
#X text 50 540 La partie décimale représente les centièmes de ton;
#X text 50 570 Vitesse: n'importe quelle valeur de 1 à 48 \, même avec décimales!;
#X msg 150 220 min 24;
#X connect 0 0 1 0;
#X connect 2 0 0 0;
#X connect 9 0 0 1;
#X connect 10 0 0 1;
#X connect 11 0 0 1;
#X connect 12 0 0 1;
#X connect 13 0 0 1;
#X connect 14 0 0 1;
#X connect 16 0 0 0;
#X connect 17 0 0 0;
