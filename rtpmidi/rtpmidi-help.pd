#N canvas 100 100 650 450 14;
#X obj 50 80 rtpmidi;
#X text 50 30 rtpmidi - auto-connecte une session RTP-MIDI depuis un patch Pd;
#X text 50 120 Status: squelette - le backend macOS (Core MIDI Network Session) sera ajoute ensuite.;
#X text 50 160 Sur Linux\, utiliser rtpmidid (Avahi pour la decouverte).;
#X text 50 180 Sur Windows\, utiliser le driver rtpMIDI de Tobias Erichsen.;
#X text 50 200 Un message console est affiche a la creation pour indiquer la marche a suivre selon l'OS.;
#X obj 50 260 print rtpmidi-status;
#X connect 0 0 6 0;
