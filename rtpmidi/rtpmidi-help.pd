#N canvas 524 125 721 659 12;
#X obj 40 451 rtpmidi;
#X text 40 20 rtpmidi - auto-connecte une session RTP-MIDI (Network MIDI);
#X text 40 50 Sur macOS\\\, pilote MIDINetworkSession de Core MIDI directement.;
#X text 40 81 Sur Linux / Windows\\\, poste un message d'aide a la creation;
#X text 40 101 (configurer rtpmidid / rtpMIDI manuellement - voir README).;
#X msg 40 151 enable 1;
#X msg 41 173 enable 0;
#X text 119 163 active / desactive la session reseau;
#X msg 40 207 policy anyone;
#X msg 42 228 policy contacts;
#X msg 43 251 policy none;
#X text 163 251 qui peut se connecter;
#X msg 41 292 connect 192.168.1.42 5004;
#X text 325 297 ajoute un peer (port par defaut 5004);
#X msg 40 321 disconnect;
#X text 215 322 retire les peers ajoutes par cet objet;
#X msg 40 361 bang;
#X text 110 361 rapporte enabled + nombre de connexions;
#X obj 40 481 print rtpmidi-status;
#X text 40 510 Sortie (symbole + liste):;
#X text 40 530 - enabled <0|1>;
#X text 40 550 - policy <anyone|contacts|none>;
#X text 310 530 - connected <host> <port>;
#X text 310 550 - disconnected;
#X msg 41 395 scan 1;
#X msg 115 395 scan 0;
#X text 200 395 decouverte Bonjour (_apple-midi._udp);
#X text 215 420 par nom Bonjour (apres scan 1);
#X text 40 570 - scanning <0|1>;
#X text 310 570 - peer <name> <host> <port>;
#X text 40 590 - peer-removed <name>;
#X msg 41 420 connect nidmi_imu;
#X connect 0 0 18 0;
#X connect 5 0 0 0;
#X connect 6 0 0 0;
#X connect 8 0 0 0;
#X connect 9 0 0 0;
#X connect 10 0 0 0;
#X connect 12 0 0 0;
#X connect 14 0 0 0;
#X connect 16 0 0 0;
#X connect 24 0 0 0;
